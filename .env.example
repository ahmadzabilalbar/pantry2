# Copy to .env.local for `vercel dev` / the tools, and set the same values in
# Vercel -> Project -> Settings -> Environment Variables. Never commit real values.

# Google Sheet that holds the data (the long id in its URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit)
GOOGLE_SHEET_ID=

# Service account with access to that sheet (share the sheet with its
# client_email as Editor). Paste the whole downloaded JSON key on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Signs the session cookie. At least 32 random characters, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every device out.
SESSION_SECRET=

# Google sign-in (OAuth client, type "Web application"). Redirect URIs:
#   https://<your-domain>/auth/google/callback
#   http://localhost:3000/auth/google/callback
# Who may sign in is ADMIN_EMAILS in lib/auth.js, not configured here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Vercel Blob read/write token (created automatically when you connect a Blob
# store to the project; copy it here for local dev and the import tool).
BLOB_READ_WRITE_TOKEN=
